# ─────────────────────────────────────────────────────────────────────────────
# Sinal RH — API (PRODUÇÃO / VPS Easypanel)
# Copie estes valores como variáveis de ambiente no serviço do Easypanel.
# NÃO comite o .env real — só este exemplo.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="Sinal RH API"
APP_ENV=production
APP_KEY=                      # gere com: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://api.saralinhar.com.br
APP_TIMEZONE=America/Sao_Paulo

# CRÍTICO p/ cookie + CORS: origem exata do front (mesmo site = saralinhar.com.br)
FRONTEND_URL=https://sinalrh.saralinhar.com.br

LOG_CHANNEL=stack
LOG_LEVEL=warning

# ── Banco de dados (serviço MySQL do Easypanel) ──────────────────────────────
DB_CONNECTION=mysql
DB_HOST=                      # nome do serviço MySQL no Easypanel (ex.: sinalrh-db)
DB_PORT=3306
DB_DATABASE=sinal_rh
DB_USERNAME=
DB_PASSWORD=

# ── Cache / Fila ─────────────────────────────────────────────────────────────
# Com Redis (recomendado): mantenha 'redis' e preencha REDIS_* abaixo.
# Sem Redis: troque os dois para 'database' (usa a tabela jobs já existente)
#            e NÃO precisa do serviço Redis.
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis

# Sessão via cookie (nossa autenticação httpOnly)
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true    # HTTPS em produção
SESSION_SAME_SITE=lax         # mesmo site (api.* e sinalrh.* sob saralinhar.com.br)
# SESSION_DOMAIN=             # deixe vazio (cookie host-only em api.saralinhar.com.br)

# ── Redis (serviço Redis do Easypanel) ───────────────────────────────────────
REDIS_HOST=                   # nome do serviço Redis no Easypanel (ex.: sinalrh-redis)
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── E-mail (envio de relatórios e convites) ──────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@saralinhar.com.br"
MAIL_FROM_NAME="Sinal RH"

# ── OpenAI (relatórios com IA) ───────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_ORGANIZATION=

# ── Asaas (cobrança) — mantenha desligado até validar ────────────────────────
ASAAS_ENABLED=false
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
ASAAS_TIMEOUT=15
ASAAS_DEFAULT_BILLING_TYPE=UNDEFINED

# ── Armazenamento ────────────────────────────────────────────────────────────
# Disco local apontando para o volume persistente montado em storage/
FILESYSTEM_DISK=local

# Sanctum (tokens) — domínio da API
SANCTUM_STATEFUL_DOMAINS=api.saralinhar.com.br

RADAR_VERSAO=1.0.0
