APP_NAME="Sinal RH API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo

# Frontend PWA URL (para CORS)
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=radar_pessoas
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@radarapessoas.com.br"
MAIL_FROM_NAME="Sinal RH"

# OpenAI para geração de relatórios com IA
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_ORGANIZATION=

# ── Asaas (gateway de cobrança) ───────────────────────────────────────────────
# IMPORTANTE: ASAAS_ENABLED=false impede qualquer chamada à API Asaas (kill switch).
# Ative apenas quando estiver com a integração validada.
ASAAS_ENABLED=false
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
ASAAS_TIMEOUT=15
ASAAS_DEFAULT_BILLING_TYPE=UNDEFINED

# AWS S3 para armazenamento de anexos (opcional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=sa-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# Configurações do produto
RADAR_MAX_EMPRESAS_FREE=1
RADAR_MAX_COLABORADORES_FREE=50
RADAR_VERSAO=1.0.0

# ── Seed inicial (php artisan migrate:fresh --seed) ───────────────────────────
EMPRESA_NOME="Nome da Empresa"
EMPRESA_RAZAO_SOCIAL="Razão Social Ltda."
EMPRESA_CNPJ="00.000.000/0001-00"
EMPRESA_EMAIL="rh@empresa.com.br"
EMPRESA_TELEFONE="(00) 0000-0000"

ADMIN_NOME="Administrador"
ADMIN_EMAIL="admin@empresa.com.br"
ADMIN_PASSWORD="trocar@123"
