node_modules/
dist/
dev-dist/
.vite/
*.local

# ── Backend (Laravel) ──────────────────────────────────────────────────────
backend/vendor/
backend/node_modules/
backend/.phpunit.result.cache
backend/.phpunit.cache/

# ── Variáveis de ambiente ──────────────────────────────────────────────────
.env
.env.local
.env.*.local
backend/.env
backend/.env.backup
backend/.env.production
!.env.example
!backend/.env.example

# ── Storage e arquivos gerados ─────────────────────────────────────────────
backend/storage/app/nr1/
backend/storage/app/tmp/
backend/storage/app/public/
